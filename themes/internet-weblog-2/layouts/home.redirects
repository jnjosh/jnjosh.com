{{/* Generated from internet-weblog-2 1.0.0-beta.6 — do not edit here. */}}{{- $cutoff := site.Params.migratedBefore -}}
{{- if $cutoff -}}
# Generated by the internet-weblog theme — do not edit by hand.
# Per-entry rules for content that existed at migration ({{ $cutoff }}).{{ range where (where (where site.RegularPages "Date" "lt" $cutoff) "Section" "in" site.Params.mainSections) "Type" "not in" (slice "videos" "audio") -}}{{- $old := printf "/%s/%s/" .Type (path.Base .RelPermalink) -}}
{{- with .Params.legacyurl }}{{ $old = . }}{{ end -}}
{{- if ne $old .RelPermalink }}
{{ $old }}  {{ .RelPermalink }}  301
{{- end }}
{{- end }}
{{ end }}
# Section-level rules. The old sections were already a rough proxy for
# the split, so each maps to the space it was effectively already aligned with rather
# than to the combined feed — a `/posts/index.xml` subscriber was, in practice,
# subscribed to the Workshop.
/posts/  /workshop/  301
/posts/index.xml  /workshop/index.xml  301
/photos/  /studio/  301
/photos/index.xml  /studio/index.xml  301

# The per-type paths inside a space are never pages (§2) — they carry the cascade and
# suppress themselves. Nothing is emitted at these paths, so a plain rule suffices with
# no Netlify force flag: there is no static file for the rule to shadow.
/workshop/posts/  /workshop/  301
/studio/posts/  /studio/  301
/studio/photos/  /studio/  301

# The old site's own pagination. The original home WAS the archive — one
# unified stream, paginated at the root — so `/page/2/` matches nothing above and would
# 404. It goes to `/` because that is the page it was the second screen of; sending it to
# a space would pick one on the reader's behalf that they never picked. Static, not
# derived: there is no page in the content to derive it from.
/page/*  /  301

# Microposts are retired but do NOT move (§6) — they keep their URLs, so they need no
# rule here. Their feed stays frozen in place rather than redirecting.
